# Copy to `.env` for docker compose. NEVER commit .env. Values below are DEV-ONLY placeholders:
# replace every "change-me". Use URL-safe passwords (letters, digits, - and _): several are
# embedded in connection URLs.

# --- PostgreSQL (roles are created by deploy/helm/slm-studio/files/postgres-init.sh on first boot)
POSTGRES_PASSWORD=change-me-postgres-superuser
SLM_MIGRATOR_DB_PASSWORD=change-me-migrator
SLM_APP_DB_PASSWORD=change-me-app
MLFLOW_DB_PASSWORD=change-me-mlflow

# --- Redis
REDIS_PASSWORD=change-me-redis

# --- Object storage (MinIO). Buckets: models, datasets, rag-documents, checkpoints, reports
MINIO_ROOT_USER=slmadmin
MINIO_ROOT_PASSWORD=change-me-minio-min-8-chars

# --- Auth: HS256 signing secret for local dev (production uses RS256 key pair via secrets)
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SLM_JWT_SECRET=change-me-generate-a-long-random-string

# --- Observability
GRAFANA_ADMIN_PASSWORD=change-me-grafana
SLM_LOG_LEVEL=INFO

# --- Image tag for locally built images
TAG=dev

# --- Model serving (profiles: stub | vllm | gpu | trainer)
HF_TOKEN=
VLLM_IMAGE=vllm/vllm-openai:v0.10.2
VLLM_MODEL=microsoft/Phi-4-mini-instruct
VLLM_SERVED_NAME=phi-4-mini
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.85

# --- Trainer profile only: shared secret the trainer uses to report to the finetune service
SLM_TRAINER_TOKEN=

# syntax=docker/dockerfile:1.9
#
# Fine-tuning image (Unsloth + PEFT + TRL + transformers).
# Built on NVIDIA PyTorch container for Blackwell GB10 (aarch64).
#
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.09-py3

FROM ${BASE_IMAGE}

ARG VERSION=dev
ARG REVISION=unknown
ARG SOURCE=https://github.com/your-org/slm-studio
LABEL org.opencontainers.image.title="slm-studio-trainer" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="${SOURCE}"

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 trainer \
 && useradd  --system --uid 10001 --gid 10001 --no-create-home --home-dir /work --shell /usr/sbin/nologin trainer \
 && mkdir -p /work && chown 10001:10001 /work

COPY deploy/docker/trainer/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY --chown=10001:10001 deploy/docker/trainer/train.py /app/train.py

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/work \
    HF_HOME=/work/.cache/huggingface \
    BNB_CUDA_VERSION=132 \
    TRITON_CACHE_DIR=/work/triton \
    TORCHINDUCTOR_CACHE_DIR=/work/inductor \
    UNSLOTH_COMPILE_LOCATION=/work/unsloth_cache \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    SLM_TRAINER_WORKDIR=/work

WORKDIR /work
USER 10001:10001

ENTRYPOINT ["/usr/bin/tini", "--", "python", "/app/train.py"]

            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(vllm:gpu_prefix_cache_hits_total{slm_deployment=~\"$deployment\"}[$__rate_interval])) / clamp_min(sum(rate(vllm:gpu_prefix_cache_queries_total{slm_deployment=~\"$deployment\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "gpu_prefix_cache (v0)",
          "range": true,

      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(vllm:num_requests_running{slm_deployment=~\"$deployment\"})",
          "legendFormat": "",
          "range": true,
          "instant": false

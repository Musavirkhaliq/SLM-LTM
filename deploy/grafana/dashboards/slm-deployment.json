      "id": 13,
      "type": "timeseries",
      "title": "Prefix-cache hit rate",
      "description": "Requires --enable-prefix-caching. Only the series your vLLM version exports will be populated.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"

        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * sum(rate(slm_http_requests_total{service=\"gateway\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(slm_http_requests_total{service=\"gateway\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
